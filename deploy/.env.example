# Kopieren nach deploy/.env (wird nicht committet) und anpassen.
# Keine echten Passwörter in diese Beispieldatei schreiben.

# Name des Compose-Projekts – trennt Staging und spätere Produktion auf demselben Server
COMPOSE_PROJECT_NAME=trainerhub-staging

# Öffentliche Adresse (für CORS von PocketBase). Muss exakt der Browser-Origin entsprechen.
TRAINERHUB_PUBLIC_URL=https://trainerhub-staging.example.org

# Upstream-Adresse für den vorhandenen Reverse Proxy (Host:Port). Port frei wählen, nachdem
# geprüft wurde, dass er frei ist. 127.0.0.1 = nur lokal erreichbar (empfohlen).
WEB_BIND=127.0.0.1:18090

# PocketBase-Dashboard nur lokal, Zugriff per: ssh -L 18091:127.0.0.1:18091 <server>
PB_ADMIN_BIND=127.0.0.1:18091

# Persistente PocketBase-Daten auf dem Host (Besitzer UID 10001, siehe Handoff-Doku)
PB_DATA_DIR=./data/pb_data

# 32 zufällige Zeichen, z. B.: openssl rand -hex 16  – danach NIE mehr ändern
PB_ENCRYPTION_KEY=

# Zielverzeichnis für Backups (außerhalb von PB_DATA_DIR)
BACKUP_DIR=./backups
# Wie viele tägliche Snapshots behalten
BACKUP_KEEP=14

TRAINERHUB_IMAGE_TAG=local
